# Mailbox host. Leave BIND on loopback until the two PCs share a Tailscale network.
# BIND=100.x.x.x
# PORT=8787
# AGENTS_FILE=agents.json
# DATA_DIR=data/mailbox
# ALLOW_PUBLIC_BIND=1
# MAILBOX_ALLOWED_ORIGINS=

# Adapter on this PC. MAILBOX_URL is the host's Tailscale address.
# On the host, that address is this machine's own Tailscale IP.
# MAILBOX_URL=http://100.x.x.x:8787/mcp
# AGENT_ID=desktop-builder
# AGENT_TOKEN=paste-the-token-from-npm-run-init
# ADAPTER_PORT=8788
# ADAPTER_DATA_DIR=data/adapter
# POLL_MS=5000
# MAILBOX_TIMEOUT_MS=20000

# Wake an idle Cursor, Antigravity (Gemini), Claude Code, or Codex agent when mail arrives: off, cli, or apply.
# off: leave messages in the local spool for an open agent chat.
# cli: start a read-only CLI turn.
# apply: allow the CLI agent to edit WAKE_WORKSPACE. Peer text is still untrusted.
# WAKE=off
# WAKE_CLIENT=cursor   (cursor: agent -p; gemini/antigravity: agy -p; claude: claude -p; codex: codex exec)
# WAKE_WORKSPACE=D:\Projects\your-checkout
# WAKE_TIMEOUT_MS=600000

# Docker (docker compose up -d --build): the mailbox host runs in a container.
# MAILBOX_PORT=8797        host port remote PCs connect to
# LAN_BIND=0.0.0.0         host address to publish on; use one LAN IP to restrict it
