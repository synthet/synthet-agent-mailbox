# Peer messaging. Keys and queues live here. The default is ~/.agent-mail.
# AGENT_MAIL_HOME=

# Legacy central mailbox and per-PC adapter. Prefer `node dist/cli.js` for new setups.
# BIND=127.0.0.1
# PORT=8787
# AGENTS_FILE=agents.json
# DATA_DIR=data/mailbox
# ALLOW_PUBLIC_BIND=1
# MAILBOX_ALLOWED_ORIGINS=
# MAILBOX_URL=http://100.x.x.x:8787/mcp
# AGENT_ID=desktop-builder
# AGENT_TOKEN=paste-the-token-from-npm-run-legacy:init
# ADAPTER_PORT=8788
# ADAPTER_DATA_DIR=data/adapter
# Inside the adapter container only. Compose sets these; do not use them for npm run adapter.
# ADAPTER_CONTAINER=1
# ADAPTER_BIND=0.0.0.0
# POLL_MS=5000
# MAILBOX_TIMEOUT_MS=20000
# WAKE=off
# WAKE_CLIENT=cursor
# WAKE_WORKSPACE=D:\Projects\your-checkout
# WAKE_TIMEOUT_MS=600000
