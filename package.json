{
  "name": "mcp-agent-mailbox",
  "version": "0.2.0",
  "description": "Shared MCP mailbox and per-PC adapter for Cursor, Antigravity (Gemini), Claude Code, and Codex agents",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "init": "tsx src/init.ts",
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "adapter": "tsx src/adapter-main.ts",
    "start:adapter": "node dist/adapter-main.js",
    "test": "node --import tsx --test test/protocol.test.ts test/wake.test.ts test/integration.test.ts"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^11.6.0",
    "express": "^4.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
