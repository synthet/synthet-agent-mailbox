{
  "name": "mcp-agent-mailbox",
  "version": "0.3.0",
  "description": "Direct encrypted peer messaging with LAN discovery, a standalone CLI, and stdio MCP",
  "type": "module",
  "main": "dist/cli.js",
  "bin": { "agent-mail": "dist/cli.js" },
  "scripts": {
    "init": "node dist/cli.js init",
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "peer": "node dist/cli.js",
    "mcp": "node dist/cli.js mcp",
    "legacy:init": "tsx src/init.ts",
    "legacy:mailbox": "node dist/index.js",
    "adapter": "tsx src/adapter-main.ts",
    "start:adapter": "node dist/adapter-main.js",
    "test": "npm run build && node --test test/peer.test.mjs",
    "test:legacy": "node --import tsx --test test/protocol.test.ts test/wake.test.ts test/integration.test.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0",
    "better-sqlite3": "^11.6.0",
    "express": "^4.21.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.0"
  }
}
